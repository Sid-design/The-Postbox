# EAS Build upload ignore list.
# NOTE: when this file is present, EAS uses it INSTEAD of .gitignore to decide
# what to upload, copying the WORKING TREE (not the git archive).
#
# This project is CNG / MANAGED: the native ios/ and android/ folders are NOT
# uploaded, so EAS Build runs `expo prebuild` on the server and regenerates the
# native projects from app.config.js (all plugins, scheme, ios config, and the
# architecture flag are applied). Do NOT remove ios/ or android/ from this list
# unless you intend to go back to a bare workflow (which requires uploading and
# hand-maintaining ios/ — that is what caused the standalone black screen).

# Native projects — regenerated by prebuild on the build server
ios/
android/

# Dependencies (EAS reinstalls on the build server)
node_modules/

# Expo local state
.expo/

# Local environment (machine-specific, never upload)
.env
.env.local

# Logs / coverage / OS cruft
*.log
npm-debug.log
yarn-error.log
coverage/
.DS_Store

# Tests (not needed for a production/preview build)
**/__tests__/
**/*.test.ts
**/*.test.tsx
