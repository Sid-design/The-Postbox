{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_BABEL_NO_ADD_REANIMATED_PLUGIN": "1",
        "EXPO_PUBLIC_APP_NAME": "The Postbox (Dev)",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://the-postbox-backend.fly.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_BABEL_NO_ADD_REANIMATED_PLUGIN": "1",
        "EXPO_PUBLIC_APP_NAME": "The Postbox (Preview)",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://the-postbox-backend.fly.dev"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_BABEL_NO_ADD_REANIMATED_PLUGIN": "1",
        "EXPO_PUBLIC_APP_NAME": "The Postbox",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://the-postbox-backend.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "siddharth.daswani7@gmail.com",
        "appleTeamId": "JK23LR6DZS"
      }
    }
  }
}
